# API endpoint donde se envía cada medición (POST individual)
API_URL=https://your-api.example.com/api/measurements

# Autenticación via header HTTP
API_KEY_HEADER_NAME=X-Api-Key
API_KEY=your-api-key-here

# Cuántos registros procesar por ejecución (con crontab cada 10s, 50 es seguro)
BATCH_SIZE=50

# Timeout en segundos para cada POST HTTP
HTTP_TIMEOUT=8

# Rutas absolutas (necesario para Task Scheduler / crontab)
DB_PATH=C:\Users\erebo\Herd\servicio-envio\datos.db
LOCK_FILE=C:\Users\erebo\Herd\servicio-envio\storage\sync.lock
LOG_FILE=C:\Users\erebo\Herd\servicio-envio\storage\sync.log

# Tamaño máximo del log en bytes antes de rotar (default: 1MB)
LOG_MAX_BYTES=1048576
